# Orchestrator (this app)
PORT=3000
LOG_LEVEL=info

# Vexa — start cloud; swap base URL when self-hosting
# Cloud:   https://api.cloud.vexa.ai
# Self-hosted: http://localhost:8056
VEXA_API_BASE=https://api.cloud.vexa.ai
VEXA_API_KEY=                   # From https://vexa.ai/account

# Inbox address organizers invite (Resend dashboard → Receiving)
BOT_EMAIL=anything@your-id.resend.app
BOT_DISPLAY_NAME=Central Agent Bot

# Email — Resend (Advanced Mode, webhook)
RESEND_API_KEY=                 # Fetch email body after webhook fires
RESEND_WEBHOOK_SECRET=          # whsec_... from Resend when you create the webhook

# Who may trigger a join via email: open | strict | domain
INVITE_SENDER_MODE=open
ALLOWED_INVITE_SENDERS=
ALLOWED_INVITE_DOMAINS=

# Bot features (v1 defaults per PRD — no transcription in v1)
RECORDING_ENABLED=false
TRANSCRIBE_ENABLED=false

# Playwright fallback (when Vexa join fails)
FALLBACK_ENABLED=true
HEADLESS=true
PLAYWRIGHT_SESSION_DIR=./data/sessions

# Vexa join polling (orchestrator waits for bot status)
VEXA_JOIN_POLL_INTERVAL_MS=3000
VEXA_JOIN_TIMEOUT_MS=120000
